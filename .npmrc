# npm 10's strict peer resolver crashes ("Cannot read properties of null
# (reading 'edgesOut')") on this dependency graph (@cloudflare/vitest-pool-workers
# pins an alpha miniflare/wrangler internally). legacy-peer-deps restores the
# npm 6/7 resolution behavior, which installs cleanly. No actual peer
# conflicts exist in practice — vitest and @cloudflare/vitest-pool-workers
# are version-paired in devDependencies.
legacy-peer-deps=true
